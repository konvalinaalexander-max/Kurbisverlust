# =====================================================================
# Zwei Webseiten, zwei Dateien
#
# VITE_SUPABASE_URL und VITE_SUPABASE_ANON_KEY werden BEIM BAUEN in den
# Programmcode eingesetzt, nicht beim Laden der Seite. Zwei Webseiten
# heissen deshalb zwei Builds mit je eigener Datei:
#
#   .env.echt      →  npm run build:echt      →  die Webseite des Betriebs
#   .env.beispiel  →  npm run build:beispiel  →  die Webseite zum Ausprobieren
#
# Keine der beiden wird eingecheckt. Diese Datei ist nur das Muster.
#
# Woran man erkennt, auf welcher Seite man ist: Die Beispiel-Seite trägt
# oben ein gelbes Band „Beispieldaten — nicht der Betrieb". Das Band hängt
# an der Einstellung `betriebsmodus` in der DATENBANK, nicht am Build —
# eine Datenbank weiss immer, was sie ist, und kann nicht behaupten, die
# andere zu sein. Setze sie in jeder Datenbank einmal:
#
#   update einstellung set wert = '"beispiel"'::jsonb
#    where schluessel = 'betriebsmodus';
#
# Im Echtmodus verweigern die Beispieldaten ausserdem den Dienst — nicht
# nur in der Oberfläche, sondern als Auslöser an den Tabellen (0072).
# =====================================================================

# ---- Für die Entwicklung (npm run dev) ------------------------------
# Aus dem Supabase-Dashboard: Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---- Muster für .env.echt -------------------------------------------
# VITE_SUPABASE_URL=https://echt-projekt.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---- Muster für .env.beispiel ---------------------------------------
# VITE_SUPABASE_URL=https://beispiel-projekt.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# =====================================================================
# Die Demo hinter dem Knopf auf der Anmeldeseite (0081)
#
# Seit Runde S braucht es für eine Demo keine zweite Webseite mehr. Eine
# Webseite reicht: Wer sich anmeldet, arbeitet mit den echten Daten; wer
# vorher auf „Demo ansehen" drückt, landet in einer zweiten Datenbank mit
# einer erfundenen Saison und darf dort alles anfassen.
#
# Dafür — und nur dafür — sind diese zwei Werte da. Sie zeigen auf das
# ZWEITE Supabase-Projekt. Fehlen sie, gibt es den Knopf nicht; die App
# läuft dann genau wie vorher.
#
# Wie das zweite Projekt eingerichtet wird, steht Schritt für Schritt in
# docs/DEMO.md.
# =====================================================================

# VITE_DEMO_SUPABASE_URL=https://demo-projekt.supabase.co
# VITE_DEMO_SUPABASE_ANON_KEY=sb_publishable_...
